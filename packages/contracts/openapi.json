{
  "openapi": "3.1.0",
  "info": {
    "title": "Refrigeração Castro API",
    "version": "1.0.0",
    "description": "API RESTful do sistema da Refrigeração Castro (Mogi Mirim/SP). Erros no formato RFC 9457 (application/problem+json). Convenções em docs/API.md."
  },
