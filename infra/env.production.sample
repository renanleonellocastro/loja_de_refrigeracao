# Production settings for infra/compose.production.yaml. Copy to infra/.env.production (never commit it).
DOMAIN=refrigeracaocastro.com.br
ACME_EMAIL=contato@refrigeracaocastro.com.br
LOG_LEVEL=info

POSTGRES_USER=castro
POSTGRES_DB=castro
# openssl rand -base64 32
POSTGRES_PASSWORD=
# openssl rand -base64 48 (at least 32 characters)
JWT_SECRET=

# smtps://user:password@smtp.provider.com:465
SMTP_URL=
MAIL_FROM="Refrigeração Castro <nao-responda@refrigeracaocastro.com.br>"

# Photos: local keeps them in the storage volume; s3 sends them to any S3 compatible service
# (AWS S3, Cloudflare R2, Oracle Object Storage, MinIO). See docs/OPERACAO.md section 3.1.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=us-east-1
# Empty for AWS; the service URL otherwise, e.g. https://<namespace>.compat.objectstorage.sa-saopaulo-1.oraclecloud.com
S3_ENDPOINT=
# Defaults to true when S3_ENDPOINT is set
S3_FORCE_PATH_STYLE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Version of the images published to GHCR on each v* tag (.github/workflows/images.yml), e.g. v1.0.0.
# Leave empty to build on the server with `up -d --build` (images tagged "local").
IMAGE_TAG=

# Backups (infra/backup/backup.sh, docs/OPERACAO.md section 5). Off server copy only when the remote is set.
BACKUP_DIR=/opt/castro/backups
BACKUP_RETENTION_DAYS=30
# none when STORAGE_DRIVER=s3 (the bucket keeps the photos)
BACKUP_STORAGE=volume
# rclone destination, e.g. offsite:refrigeracao-castro-backups; its settings go in BACKUP_RCLONE_ENV_FILE
BACKUP_RCLONE_REMOTE=
BACKUP_RCLONE_ENV_FILE=
