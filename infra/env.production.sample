# Production settings for infra/compose.production.yaml. Copy to infra/.env.production (never commit it).
DOMAIN=refrigeracaocastro.com.br
ACME_EMAIL=contato@refrigeracaocastro.com.br
LOG_LEVEL=info

POSTGRES_USER=castro
POSTGRES_DB=castro
# openssl rand -base64 32
POSTGRES_PASSWORD=
# openssl rand -base64 48 (at least 32 characters)
JWT_SECRET=

# smtps://user:password@smtp.provider.com:465
SMTP_URL=
MAIL_FROM="Refrigeração Castro <nao-responda@refrigeracaocastro.com.br>"

# Optional: images published to a registry instead of building on the server.
# API_IMAGE=ghcr.io/renanleonellocastro/refrigeracao-castro-api:1.0.0
# WEB_IMAGE=ghcr.io/renanleonellocastro/refrigeracao-castro-web:1.0.0
