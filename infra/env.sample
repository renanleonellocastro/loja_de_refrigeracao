# Copy to .env and adjust. Never commit the real .env.
NODE_ENV=development
TZ=America/Sao_Paulo

# API
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://castro:castro@localhost:5433/castro
JWT_SECRET=change-me-to-a-long-random-string-with-at-least-32-chars
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Refrigeração Castro <nao-responda@refrigeracaocastro.com.br>"
# local (folder below) or s3 (any S3 compatible service, docs/OPERACAO.md section 3.1)
STORAGE_DRIVER=local
STORAGE_PATH=./storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Web
NUXT_PUBLIC_API_BASE=http://localhost:3001
